# Register http://localhost:17563/callback in the Twitch developer console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
# Set to 0 for a publishing-only worker that sends no Twitch links or MP4s to Discord.
DISCORD_CLIP_DELIVERY=1
# Send watchlist and stream status updates even if clip delivery is disabled.
# DISCORD_WATCH_ALERTS=1
# Public posting sends text receipts here when YouTube or TikTok confirms a public video.
# With DISCORD_CLIP_DELIVERY=1 this webhook also enables finished MP4 delivery.
DISCORD_FINISHED_WEBHOOK_URL=
# Default facecam check uses one screenshot on the worker CPU.
CLIP_LAYOUT_MODE=screenshot
# Optional Ollama model for visual titles and CLIP_LAYOUT_MODE=vision.
SOCIAL_VISION_MODEL=
# Optional address of a private Ollama server. Defaults to http://127.0.0.1:11434.
SOCIAL_OLLAMA_URL=
# Optional local faster-whisper model directory or previously downloaded model name.
SOCIAL_SPEECH_MODEL=
# Optional path to the local Qwen title editor. The Railway image includes its model.
# SOCIAL_TITLE_MODEL=/opt/clipmatch/Qwen3.5-2B-Q4_K_M.gguf
# Enable durable queues for new finished clips. Account grants activate each destination separately.
PUBLIC_POSTING_ENABLED=false
# Private JSON created by python -m clipmatch.youtube_publisher authorize (one line).
YOUTUBE_GRANT_JSON=
# Connect a public TikTok account to Buffer and create a personal API key.
BUFFER_API_KEY=
# Needed only when there are several TikTok accounts connected to Buffer.
BUFFER_TIKTOK_CHANNEL_ID=
# Defaults to the Railway-provided HTTPS domain. The media server uses PORT or 8080.
PUBLISH_MEDIA_ORIGIN=
# Minimum spacing per destination when clips arrive in a burst.
PUBLISH_INTERVAL_MINUTES=60
# On Railway, release new source/master files 24 hours after both platforms confirm publication.
PUBLISH_CLEANUP_CONFIRMED=0
# Replace these examples with the logins you want to watch.
CHANNELS=kaicenat,agent00,fanum,jynxzi,yourragegaming

# For a hosted worker, set TWITCH_REFRESH_TOKEN in Railway Variables.
# The local authorize command writes .clipbot/refresh-token instead.
# BUCKET_SECONDS=10
# BASELINE_MINUTES=10
# SPIKE_MULTIPLIER=3
# MIN_MESSAGES=20
# WARMUP_MINUTES=5
# COOLDOWN_SECONDS=90
